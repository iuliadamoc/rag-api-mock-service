{
  "openapi": "3.0.3",
  "info": {
    "title": "RAG Service API",
    "version": "1.0.0",
    "description": "Mock RAG API implementation aligned with external specification"
  },
  "servers": [
    {
      "url": "http://localhost:8080"
    }
  ],
  "paths": {
    "/v1/health": {
      "get": {
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "Service status"
          }
        }
      }
    },
    "/v1/query": {
      "post": {
        "summary": "Answer a question",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QueryRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Query result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueryResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/ingest": {
      "post": {
        "summary": "Ingest document",
        "requestBody": {
            "required": true,
            "content": {
                "application/json": {
                "schema": {
                    "$ref": "#/components/schemas/IngestRequest"
                }
                },
                "multipart/form-data": {
                "schema": {
                    "type": "object",
                    "required": ["payload", "file"],
                    "properties": {
                    "payload": {
                        "type": "string",
                        "description": "JSON string of IngestRequest"
                    },
                    "file": {
                        "type": "string",
                        "format": "binary"
                    }
                    }
                }
                }
            }
        },
        "responses": {
          "202": {
            "description": "Job accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestJob"
                }
              }
            }
          }
        }
      }
    },
    "/v1/ingest/{job_id}": {
      "get": {
        "summary": "Get ingest status",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Job status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestStatus"
                }
              }
            }
          }
        }
      }
    },
    "/v1/namespaces/{namespace_id}": {
      "delete": {
        "summary": "Delete namespace",
        "parameters": [
          {
            "name": "namespace_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Deletion started"
          }
        }
      }
    },
    "/v1/namespaces/{namespace_id}/stats": {
      "get": {
        "summary": "Namespace statistics",
        "parameters": [
          {
            "name": "namespace_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Namespace stats",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NamespaceStats"
                }
              }
            }
          }
        }
      }
    },
    "/v1/eval": {
      "post": {
        "summary": "Evaluation endpoint",
        "responses": {
          "200": {
            "description": "Evaluation result"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Prometheus metrics",
        "responses": {
          "200": {
            "description": "Metrics output (text/plain)"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "QueryRequest": {
        "type": "object",
        "required": ["question", "language", "namespaces"],
        "properties": {
          "question": { "type": "string" },
          "language": { "type": "string" },
          "namespaces": {
            "type": "array",
            "items": { "type": "string" }
          },
          "top_k": { "type": "integer" },
          "hint_article_number": { "type": "string" },
          "rerank": { "type": "boolean" },
          "include_answer": { "type": "boolean" }
        }
      },
      "QueryResponse": {
        "type": "object",
        "properties": {
          "request_id": { "type": "string" },
          "answer": { "type": "string", "nullable": true },
          "citations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Citation"
            }
          },
          "confidence": { "type": "number" }
        }
      },
      "Citation": {
        "type": "object",
        "properties": {
          "marker": { "type": "string" },
          "chunk": {
            "$ref": "#/components/schemas/Chunk"
          }
        }
      },
      "Chunk": {
        "type": "object",
        "properties": {
          "chunk_id": { "type": "string" },
          "content": { "type": "string" },
          "article_number": { "type": "string" },
          "source_id": { "type": "string" },
          "namespace_id": { "type": "string" },
          "score": { "type": "number" }
        }
      },
      "IngestRequest": {
        "type": "object",
        "required": ["namespace_id", "source_id", "source_type"],
        "properties": {
          "namespace_id": { "type": "string" },
          "source_id": { "type": "string" },
          "source_type": { "type": "string" },
          "url": { "type": "string" }
        }
      },
      "IngestJob": {
        "type": "object",
        "properties": {
          "job_id": { "type": "string" },
          "status": { "type": "string" },
          "submitted_at": { "type": "string" }
        }
      },
      "IngestStatus": {
        "type": "object",
        "properties": {
          "job_id": { "type": "string" },
          "status": { "type": "string" },
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        }
      },
      "NamespaceStats": {
        "type": "object",
        "properties": {
          "namespace_id": { "type": "string" },
          "chunk_count": { "type": "integer" },
          "source_count": { "type": "integer" },
          "total_tokens_indexed": { "type": "integer" },
          "last_ingested_at": { "type": "string", "nullable": true },
          "embedding_model": { "type": "string" },
          "embedding_dim": { "type": "integer" }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    }
  }
}